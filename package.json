{
  "name": "plainsight",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "release": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-local.mjs",
    "lint": "biome lint .",
    "test": "vitest run",
    "add-images": "node scripts/add-images.mjs",
    "fit-images": "node scripts/fit-images.mjs",
    "render-work": "node scripts/render-work/render.mjs",
    "render-studio": "node scripts/render-studio.mjs",
    "render-icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vite-plugin": "1.58.0",
    "@layerwise/vite": "^0.1.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "4.137.0"
  }
}
